# ==============================================================================
# Nexa - Workforce & Operations Platform: Production Environment Configuration
# ==============================================================================
# Copy this file to .env before starting services: cp .env.example .env
# docker-compose.yml automatically interpolates these variables into services.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database & HikariCP Connection Pooling
# ------------------------------------------------------------------------------
POSTGRES_DB=saas_db
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas_dev_pw

# Internal Docker connection string (container-to-container networking)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/saas_db
SPRING_DATASOURCE_USERNAME=saas
SPRING_DATASOURCE_PASSWORD=saas_dev_pw

# HikariCP Connection Pool Tuning:
# Sizing calculation: (Hikari max-pool-size * Number of backend instances) + Operational Reserve < PostgreSQL max_connections
# Example: 3 backend instances * 10 connections = 30 connections (well below PostgreSQL 100 max_connections)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# ------------------------------------------------------------------------------
# 2. Redis Cache & Token Blacklist
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Stripe Billing Engine, Webhooks & Plan Tiers
# ------------------------------------------------------------------------------
# Secret Key: sk_test_... for test mode, sk_live_... for production (keep secret!)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Webhook Signing Secret: obtained from Stripe Dashboard > Developers > Webhooks
# Production Endpoint: https://<NEXA_DOMAIN>/api/webhooks/stripe
# Events to subscribe:
#   - checkout.session.completed
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.paid
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# URLs for Stripe Checkout & Customer Portal navigation
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing

# Stripe Price IDs mapped to Plan Tiers (separate test-mode and live-mode Price IDs)
# Create recurring products in Stripe Dashboard and paste the corresponding price_ IDs:
STRIPE_PRICE_PRO_ID=price_replace_with_your_pro_price_id
STRIPE_PRICE_ENTERPRISE_ID=price_replace_with_your_enterprise_price_id

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 / Google Identity Services (GIS)
# ------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > Web application client:
#   Authorized JavaScript Origins:
#     - Development: http://localhost:5173, http://localhost:3000
#     - Production: https://<NEXA_DOMAIN>
#   Authorized Redirect URIs (if redirect mode is used):
#     - Development: http://localhost:5173/login, http://localhost:3000/login, http://localhost:8090/api/auth/google
#     - Production: https://<NEXA_DOMAIN>/login, https://<NEXA_DOMAIN>/api/auth/google
GOOGLE_CLIENT_ID=906646436149-dkke9514rgicekhqsglpavm8e5iffgug.apps.googleusercontent.com
# Note: Google Client Secret is NEVER exposed to React or browser frontend.

# ------------------------------------------------------------------------------
# 5. Security & Domain / CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated allowed production origins (e.g. https://nexa.yourdomain.com)
# Localhost origins (http://localhost:[*]) are always enabled for local development
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 6. Application Host Port Mappings
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
PORT_BACKEND=8090
PORT_POSTGRES=5434
PORT_REDIS=6380

# ------------------------------------------------------------------------------
# 7. JWT Key Pair Externalization & Expiration
# ------------------------------------------------------------------------------
# JWT_PUBLIC_KEY=classpath:certs/jwt-public.pem
# JWT_PRIVATE_KEY=classpath:certs/jwt-private.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ------------------------------------------------------------------------------
# 8. Email Infrastructure Abstraction
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=noreply@nexa.app
EMAIL_FROM_NAME=Nexa Platform
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_sendgrid_api_key

# ------------------------------------------------------------------------------
# 9. File & Document Storage Abstraction
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=memory
STORAGE_BASE_PATH=/tmp/nexa-storage
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 10. Rate Limiting (Redis-backed with in-memory fallback)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=60
RATE_LIMIT_API_PER_MIN=300

